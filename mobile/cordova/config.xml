<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.sub2api.mobile" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
  <name>Sub2API</name>
  <description>Sub2API management console</description>
  <author email="support@example.com">Sub2API</author>
  <content src="index.html" />
  <preference name="AndroidInsecureFileModeEnabled" value="false" />
  <preference name="AndroidXEnabled" value="true" />
  <preference name="GradlePluginKotlinEnabled" value="true" />
  <preference name="scheme" value="https" />
  <preference name="hostname" value="localhost" />
  <!-- The API endpoint is injected at build time. Restrict this to that host
       before publishing a store build if your Cordova policy requires it. -->
  <access origin="https://*" />
  <allow-navigation href="https://*/*" />
  <allow-intent href="https://*/*" />
  <platform name="android">
    <allow-intent href="market:*" />
  </platform>
</widget>
